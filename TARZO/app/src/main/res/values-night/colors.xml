<?xml version="1.0" encoding="utf-8"?>
<!--
    Night mode color overrides.
    TARZO is dark-first, so night values are identical to the default values.
    This file exists to explicitly ensure no light-theme bleed-in
    when the system night mode qualifier is applied.
-->
<resources>
    <color name="tarzo_dark">#0A0E17</color>
    <color name="tarzo_surface">#111827</color>
    <color name="tarzo_card">#1A2235</color>
    <color name="tarzo_accent">#00D4FF</color>
    <color name="tarzo_accent_secondary">#7C3AED</color>
    <color name="tarzo_text_primary">#F1F5F9</color>
    <color name="tarzo_text_secondary">#94A3B8</color>
    <color name="tarzo_success">#22C55E</color>
    <color name="tarzo_warning">#F59E0B</color>
    <color name="tarzo_error">#EF4444</color>
    <color name="tarzo_orb_start">#00D4FF</color>
    <color name="tarzo_orb_end">#7C3AED</color>
</resources>
