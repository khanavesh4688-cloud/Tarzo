    <!-- ============================== -->
    <!-- Permission Rationales          -->
    <!-- ============================== -->
    <string name="permission_accessibility_title">Accessibility Service Chahiye</string>
    <string name="permission_accessibility_message">TARZO ko aapke screen ko read karne ki zaroorat hai taaki wo commands automatically execute kar sake. Yeh safe hai – koi data collect nahi hota sirf on-device processing hoti hai.</string>
    <string name="permission_overlay_title">Overlay Permission Dijiye</string>
    <string name="permission_overlay_message">TARZO floating controls dikhane ke liye overlay permission chahiye. Isse aap kisi bhi screen se TARZO control kar sakte ho.</string>
    <string name="permission_camera_title">Camera Access Chahiye</string>
    <string name="permission_camera_message">TARZO camera se photos aur videos capture karne ke liye permission mangta hai. Yeh sirf tab use hoga jab aap explicitly bolenge ya command doge.</string>
    <string name="permission_microphone_title">Microphone Access Chahiye</string>
    <string name="permission_microphone_message">TARZO ko aapki awaaz sunni hai voice commands process karne ke liye. Audio sirf locally process hota hai, kahi upload nahi hota.</string>
    <string name="permission_notification_title">Notification Access Dijiye</string>
    <string name="permission_notification_message">TARZO notifications read karke intelligent actions perform kar sakta hai. Example: incoming call pe automatically speaker on karna.</string>
    <string name="permission_storage_title">Storage Permission Chahiye</string>
    <string name="permission_storage_message">Photos aur videos save karne ke liye TARZO ko storage access chahiye. Files sirf aapke device pe store hoti hain.</string>
    <string name="permission_battery_title">Battery Optimization Disable Karein</string>
    <string name="permission_battery_message">TARZO background mein smoothly chalne ke liye battery optimization se bahar rakhna padega. Warna voice commands kaam nahi karenge background mein.</string>
    <string name="permission_phone_title">Phone State Access</string>
    <string name="permission_phone_message">Incoming/outgoing calls detect karne ke liye TARZO ko phone state read karna hoga.</string>

