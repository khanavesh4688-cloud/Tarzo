<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ======================================== -->
    <!-- Base Application Theme (Material3 Dark)   -->
    <!-- ======================================== -->
    <style name="Theme.TARZO" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">

        <!-- Primary brand color -->
        <item name="colorPrimary">@color/tarzo_accent</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorPrimaryContainer">@color/tarzo_accent</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/tarzo_accent_secondary</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="colorSecondaryContainer">@color/tarzo_accent_secondary</item>
        <item name="colorOnSecondaryContainer">@android:color/black</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/tarzo_orb_start</item>
        <item name="colorOnTertiary">@android:color/black</item>

        <!-- Surface / Background -->
        <item name="android:colorBackground">@color/tarzo_dark</item>
        <item name="colorOnBackground">@color/tarzo_text_primary</item>
        <item name="colorSurface">@color/tarzo_surface</item>
        <item name="colorOnSurface">@color/tarzo_text_primary</item>
        <item name="colorSurfaceVariant">@color/tarzo_card</item>
        <item name="colorOnSurfaceVariant">@color/tarzo_text_secondary</item>

        <!-- Status & Navigation bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- No Action Bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Edge-to-edge -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fitsSystemWindows">false</item>

        <!-- Text styles -->
        <item name="android:textColorPrimary">@color/tarzo_text_primary</item>
        <item name="android:textColorSecondary">@color/tarzo_text_secondary</item>

        <!-- Status feedback colors -->
        <item name="colorError">@color/tarzo_error</item>
        <item name="colorOnError">@android:color/white</item>
        <item name="android:colorError">@color/tarzo_error</item>
    </style>

    <!-- ======================================== -->
    <!-- Splash Screen Theme                      -->
    <!-- ======================================== -->
    <style name="Theme.TARZO.Splash" parent="Theme.SplashScreen">
        <!-- Splash screen background -->
        <item name="windowSplashScreenBackground">@color/tarzo_dark</item>

        <!-- Centered icon on splash -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>

        <!-- Icon background -->
        <item name="android:windowBackground">@color/tarzo_dark</item>

        <!-- Keep splash visible until app is ready -->
        <item name="windowSplashScreenAnimationDuration">800</item>

        <!-- Post-splash theme transition -->
        <item name="postSplashScreenTheme">@style/Theme.TARZO</item>

        <!-- Status bar color during splash -->
        <item name="android:statusBarColor">@color/tarzo_dark</item>
        <item name="android:navigationBarColor">@color/tarzo_dark</item>
    </style>

</resources>
