<?xml version="1.0" encoding="utf-8"?>
<!--
    TARZO Launcher Icon Foreground
    Stylized "T" letterform inside a circle.
    Uses adaptive icon safe zone (108dp canvas, 72dp center safe area).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer ring circle -->
    <path
        android:fillColor="#00D4FF"
        android:pathData="M54,54m-42,0a42,42 0,1 1,84 0a42,42 0,1 1,-84 0" />

    <!-- Inner cutout circle (creates ring effect) -->
    <path
        android:fillColor="#0A0E17"
        android:pathData="M54,54m-36,0a36,36 0,1 1,72 0a36,36 0,1 1,-72 0" />

    <!-- Stylized "T" - top bar -->
    <path
        android:fillColor="#00D4FF"
        android:pathData="M38,34h32v6h-13v30h-6v-30h-13z" />

    <!-- Accent dot on the T top-right -->
    <path
        android:fillColor="#7C3AED"
        android:pathData="M70,34m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />

</vector>
